# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Environment values override config.txt.
# For Docker/Kubernetes secrets use the _FILE form instead, e.g. JMUSICBOT_TOKEN_FILE=/run/secrets/discord_token

# --- required ---------------------------------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications  (Bot > Reset Token). Keep it secret.
JMUSICBOT_TOKEN=
# Your Discord user ID (the bot owner): User Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID
JMUSICBOT_OWNER=

# --- recommended ------------------------------------------------------------------------------------------------
# Register slash commands in ONE server instantly (recommended while testing). Leave empty/0 for global registration
# (global commands can take up to an hour to show up).
JMUSICBOT_SLASH_GUILD=

# --- optional: Spotify link support (metadata only; audio always comes from YouTube) -------------------------------
# Without these, Spotify links still work through public page data (less reliable). Create an app at
# https://developer.spotify.com/dashboard - note that Spotify restricts API access for new apps.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- optional: YouTube sign-in workarounds (needed on most VPS/datacenter IPs) -------------------------------------
# Option A: OAuth with a THROWAWAY Google account. Set to LOGIN once, read the instructions in the log, authorise, then
#           replace LOGIN with the refresh token printed in the log.
YOUTUBE_REFRESH_TOKEN=
# Option B: poToken + visitorData (see https://github.com/lavalink-devs/youtube-source#using-a-potoken)
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# --- advanced: ANY config.txt option can be set as CONFIG_FORCE_<name> (dots become underscores) ------------------
# Message Content Intent: typed requests in a request channel and custom text prefixes. Enable the intent in the
# Developer Portal FIRST, otherwise Discord rejects the login.
#CONFIG_FORCE_messagecontent=true
#CONFIG_FORCE_ratelimit_commands=8
#CONFIG_FORCE_maxqueuesize=200
#CONFIG_FORCE_maxtime=3600
#CONFIG_FORCE_alonetimeuntilstop=300
#CONFIG_FORCE_loglevel=debug
